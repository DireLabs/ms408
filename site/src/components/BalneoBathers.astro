---
// A more illustrative (but still tasteful) bathing scene inspired by the balneo section: several
// figures shown only from the shoulders up at the waterline of a scalloped, tube-fed pool — head,
// shoulders, arms; nothing below the water. Original art, not traced from any scan. Decorative.
const { size = 260 } = Astro.props;
const wl = 92;                 // waterline
const bathers = [70, 130, 190];
const fig = (x) => ({
  head: { cx: x, cy: wl - 38, r: 8 },
  neck: `M${x} ${wl - 30} L${x} ${wl - 24}`,
  torso: `M${x - 16} ${wl - 8} C${x - 16} ${wl - 22} ${x - 6} ${wl - 25} ${x} ${wl - 25} C${x + 6} ${wl - 25} ${x + 16} ${wl - 22} ${x + 16} ${wl - 8}`,
  armL: `M${x - 15} ${wl - 14} C${x - 26} ${wl - 12} ${x - 28} ${wl - 4} ${x - 23} ${wl + 2}`,
  armR: `M${x + 15} ${wl - 14} C${x + 26} ${wl - 12} ${x + 28} ${wl - 4} ${x + 23} ${wl + 2}`,
});
---
<div class="balneo-bathers" aria-hidden="true">
  <svg viewBox="0 0 260 150" width={size} height={size * 150 / 260} role="presentation">
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <!-- basin -->
      <path d="M22 60 C22 108 46 140 130 140 C214 140 238 108 238 60" />
      <path d="M14 60 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0 q11 -11 22 0" />
      <!-- feed tubes -->
      <path d="M22 60 C4 54 4 30 22 28" /><path d="M238 60 C256 54 256 30 238 28" />
      <!-- bathers (shoulders-up) -->
      {bathers.map((x) => { const f = fig(x); return (
        <g>
          <circle cx={f.head.cx} cy={f.head.cy} r={f.head.r} fill="currentColor" fill-opacity="0.10" />
          <path d={f.neck} /><path d={f.torso} /><path d={f.armL} /><path d={f.armR} />
        </g>
      ); })}
      <!-- water in front -->
      <path d="M30 92 q100 16 200 0" stroke-width="1.5" />
      <path d="M36 106 q94 14 188 0" stroke-opacity="0.8" />
      <path d="M44 120 q86 12 172 0" stroke-opacity="0.6" />
    </g>
  </svg>
</div>

<style>
  .balneo-bathers { color: var(--accent); opacity: 0.92; line-height: 0; display: inline-block; }
  .balneo-bathers svg { height: auto; max-width: 100%; }
</style>
