---
// Original "balneological plumbing" divider — inspired by the connective tubes/reservoirs of the
// manuscript's bathing (balneo) section. Not traced from any scan. Decorative; currentColor.
---
<div class="balneo-tubes" aria-hidden="true">
  <svg viewBox="0 0 300 44" width="300" height="44" role="presentation">
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <!-- twin undulating tube -->
      <path d="M12 18 C 55 4 95 4 130 18 C 165 32 205 32 240 18 C 258 13 274 13 288 18"/>
      <path d="M12 26 C 55 12 95 12 130 26 C 165 40 205 40 240 26 C 258 21 274 21 288 26"/>
      <!-- bulbous reservoirs straddling the tube -->
      <ellipse cx="130" cy="22" rx="9" ry="13" fill="currentColor" fill-opacity="0.10"/>
      <ellipse cx="240" cy="22" rx="8" ry="11" fill="currentColor" fill-opacity="0.10"/>
      <!-- end basins -->
      <path d="M12 13 a11 9 0 0 0 0 18" fill="currentColor" fill-opacity="0.08"/>
      <path d="M288 13 a11 9 0 0 1 0 18" fill="currentColor" fill-opacity="0.08"/>
      <!-- small ferrules -->
      <line x1="70" y1="8" x2="70" y2="16"/><line x1="190" y1="28" x2="190" y2="36"/>
    </g>
  </svg>
</div>

<style>
  .balneo-tubes { display: flex; justify-content: center; margin: 1.8rem 0; color: var(--accent); opacity: 0.82; }
  .balneo-tubes svg { max-width: 100%; height: auto; }
</style>
