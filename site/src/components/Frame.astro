---
// A marginalia frame — a bordered callout with original corner flourishes, for highlighting
// content in themed (manuscript) sections. Decorative; corners use currentColor (rubric in-theme).
const { title } = Astro.props;
const corner = `<svg viewBox="0 0 44 44" width="22" height="22" fill="none" stroke="currentColor"
  stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
  <path d="M4 22 C4 12 12 4 22 4"/><path d="M22 4 c6 0 6 6 0 6"/><path d="M4 22 c0 -6 6 -6 6 0"/></svg>`;
const corners = ['tl', 'tr', 'br', 'bl'];
---
<div class="ms-frame">
  {corners.map((pos) => <span class={`ms-corner ${pos}`} set:html={corner} />)}
  {title && <p class="ms-frame-title">{title}</p>}
  <slot />
</div>

<style>
  .ms-frame {
    position: relative;
    border: 1px solid var(--accent, #9e3b2f);
    background: rgba(255, 255, 255, 0.35);
    padding: 1.5rem 1.7rem;
    margin: 1.8rem 0;
    border-radius: 2px;
  }
  .ms-frame-title {
    font-family: var(--font-serif, Georgia, serif);
    color: var(--accent, #9e3b2f);
    font-size: 1.15rem;
    margin: 0 0 0.5rem;
  }
  .ms-corner { position: absolute; width: 22px; height: 22px; line-height: 0; color: var(--accent, #9e3b2f); }
  .ms-corner.tl { top: -2px; left: -2px; }
  .ms-corner.tr { top: -2px; right: -2px; transform: rotate(90deg); }
  .ms-corner.br { bottom: -2px; right: -2px; transform: rotate(180deg); }
  .ms-corner.bl { bottom: -2px; left: -2px; transform: rotate(270deg); }
</style>
