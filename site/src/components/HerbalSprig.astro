---
// Original manuscript-herbal illustration — a stylized (imaginary, Voynich-herbal-flavored)
// plant with a bulbous root, a stem, paired leaves, and a crowning flower. Not traced from any
// scan. Decorative; uses currentColor.
const { size = 130 } = Astro.props;
---
<div class="herbal-sprig" aria-hidden="true">
  <svg viewBox="0 0 120 210" width={size} height={size * 210 / 120} role="presentation">
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <!-- roots -->
      <path d="M60 176 C54 190 46 196 40 204" />
      <path d="M60 176 C66 190 74 196 80 204" />
      <path d="M60 176 C58 192 58 198 57 206" />
      <ellipse cx="60" cy="172" rx="13" ry="10" fill="currentColor" fill-opacity="0.10" />
      <!-- stem -->
      <path d="M60 162 C60 130 60 96 60 60" />
      <!-- lower leaf pair -->
      <path d="M60 138 C42 134 30 120 26 104 C44 106 56 118 60 132 Z" fill="currentColor" fill-opacity="0.09" />
      <path d="M60 138 C78 134 90 120 94 104 C76 106 64 118 60 132 Z" fill="currentColor" fill-opacity="0.09" />
      <!-- upper leaf pair -->
      <path d="M60 104 C46 100 38 90 35 78 C49 80 57 90 60 100 Z" fill="currentColor" fill-opacity="0.09" />
      <path d="M60 104 C74 100 82 90 85 78 C71 80 63 90 60 100 Z" fill="currentColor" fill-opacity="0.09" />
      <!-- flower head: petals + center -->
      <g transform="translate(60 44)">
        <g stroke-opacity="0.9">
          <path d="M0 -2 C-6 -14 -14 -14 -12 -4 C-8 2 -2 2 0 -2 Z" fill="currentColor" fill-opacity="0.12" />
          <path d="M0 -2 C6 -14 14 -14 12 -4 C8 2 2 2 0 -2 Z" fill="currentColor" fill-opacity="0.12" />
          <path d="M0 -4 C-3 -18 3 -18 0 -4 Z" fill="currentColor" fill-opacity="0.12" />
          <path d="M0 0 C-14 -2 -14 6 -4 6 C2 4 2 0 0 0 Z" fill="currentColor" fill-opacity="0.12" />
          <path d="M0 0 C14 -2 14 6 4 6 C-2 4 -2 0 0 0 Z" fill="currentColor" fill-opacity="0.12" />
        </g>
        <circle cx="0" cy="0" r="3.4" fill="currentColor" fill-opacity="0.28" />
      </g>
    </g>
  </svg>
</div>

<style>
  .herbal-sprig { color: var(--accent); opacity: 0.9; line-height: 0; }
  .herbal-sprig svg { height: auto; }
</style>
