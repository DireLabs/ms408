---
// Original concentric-ring "rosette" motif inspired by the manuscript's cosmological/zodiac
// pages (not traced from any scan). Decorative; uses currentColor.
const { size = 96 } = Astro.props;
const ticks = Array.from({ length: 24 }, (_, i) => (i * 15));
---
<div class="rosette" aria-hidden="true">
  <svg viewBox="0 0 100 100" width={size} height={size} role="presentation">
    <g fill="none" stroke="currentColor" stroke-width="1">
      <circle cx="50" cy="50" r="46" />
      <circle cx="50" cy="50" r="38" stroke-opacity="0.65" />
      <circle cx="50" cy="50" r="20" stroke-opacity="0.5" />
      {ticks.map((a) => (
        <line x1="50" y1="4" x2="50" y2="10" transform={`rotate(${a} 50 50)`} stroke-opacity="0.6" />
      ))}
      <g stroke-opacity="0.8">
        {[0, 60, 120, 180, 240, 300].map((a) => (
          <path d="M50 30 C54 42 58 46 50 50 C42 46 46 42 50 30 Z" transform={`rotate(${a} 50 50)`}
            fill="currentColor" fill-opacity="0.12" />
        ))}
      </g>
      <circle cx="50" cy="50" r="3" fill="currentColor" fill-opacity="0.3" />
    </g>
  </svg>
</div>

<style>
  .rosette { color: var(--accent); opacity: 0.9; line-height: 0; }
  .rosette svg { height: auto; }
</style>
