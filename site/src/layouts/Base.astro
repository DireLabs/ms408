---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-serif/400.css';
import '@fontsource/ibm-plex-serif/600.css';
import '../styles/global.css';
import '../styles/theme-ms408.css';
import { REPO_URL, SITE_TITLE, href } from '../config';
const { title, description, active, theme, noindex } = Astro.props;
// theme="ms408" -> class "theme-ms408"; theme="ms408-media" -> "theme-ms408-media"; etc.
const bodyClass = theme ? `theme-${theme}` : '';
const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const desc = description || 'An honest, reproducible toolkit and shared benchmark for Voynich-Manuscript research.';
// Canonical URL (absolute when `site` is configured; falls back to the path).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const nav = [
  { label: 'Home', path: '', key: 'home' },
  { label: 'Docs', path: 'docs', key: 'docs' },
  { label: 'Papers', path: 'papers', key: 'papers' },
  { label: 'Timeline', path: 'timeline', key: 'timeline' },
  { label: 'Library', path: 'library', key: 'library' },
  { label: 'Media', path: 'media', key: 'media' },
  { label: 'About', path: 'about', key: 'about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="color-scheme" content="light" />
    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MS408" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
  </head>
  <body class={bodyClass}>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={href('')}>MS408</a>
        <nav>
          {nav.map((n) => (
            <a href={href(n.path)} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
          <a href={REPO_URL} rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>MS408 — an open, reproducible toolkit and benchmark for Voynich research.
          Apache-2.0. Honest about what the evidence can and can't show.</span>
        <span><a href={href('cite')}>Cite</a> · <a href={REPO_URL}>Source</a>
          <a href={href('balneo')} title="?" aria-label="a hidden page"
            style="margin-left:0.6rem;opacity:0.4;text-decoration:none">&#10086;</a></span>
      </div>
    </footer>
  </body>
</html>
