{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "46rem", "wideSize": "62rem" },
    "color": {
      "palette": [
        { "slug": "ink", "name": "Iron-gall ink", "color": "#2b2117" },
        { "slug": "vellum", "name": "Vellum", "color": "#f3ead6" },
        { "slug": "vellum-panel", "name": "Vellum panel", "color": "#fbf5e6" },
        { "slug": "rubric", "name": "Rubric", "color": "#9e3b2f" },
        { "slug": "botanical", "name": "Botanical", "color": "#6b7250" },
        { "slug": "faded-blue", "name": "Faded blue", "color": "#5b6b7a" },
        { "slug": "tan-line", "name": "Tan hairline", "color": "#e2d5b6" },
        { "slug": "architectural-ink", "name": "Architectural ink", "color": "#161616" },
        { "slug": "architectural-bg", "name": "Architectural bg", "color": "#f5f5f3" },
        { "slug": "architectural-blue", "name": "Architectural blue", "color": "#0f62fe" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "plex-sans", "name": "IBM Plex Sans",
          "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif" },
        { "slug": "plex-serif", "name": "IBM Plex Serif",
          "fontFamily": "\"IBM Plex Serif\", Georgia, serif" },
        { "slug": "plex-mono", "name": "IBM Plex Mono",
          "fontFamily": "\"IBM Plex Mono\", ui-monospace, monospace" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--vellum)", "text": "var(--wp--preset--color--ink)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--plex-sans)" },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--rubric)" } },
      "h1": { "typography": { "fontFamily": "var(--wp--preset--font-family--plex-serif)" } },
      "h2": { "typography": { "fontFamily": "var(--wp--preset--font-family--plex-serif)" } }
    }
  },
  "_comment": "MS408 WordPress block-theme starter (manuscript flavor). Architectural palette is included as separate slugs so a variation can swap the base styles to the blueprint look. Derived from theme-kit/tokens.css."
}
